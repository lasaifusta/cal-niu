function injectIcons(){
  document.querySelectorAll("[data-ic]").forEach(function(el){
    var k=el.getAttribute("data-ic");
    if(ICONS[k]) el.innerHTML='<svg viewBox="0 0 24 24" aria-hidden="true">'+ICONS[k]+'</svg>';
  });
}
function setLang(lang){
  var dict=I18N[lang]||I18N.ca;
  document.querySelectorAll("[data-i18n]").forEach(function(el){
    var k=el.getAttribute("data-i18n");
    if(dict[k]!=null) el.textContent=dict[k];
  });
  document.documentElement.lang=lang;
  document.querySelectorAll(".lang button").forEach(function(b){b.classList.toggle("on",b.dataset.lang===lang);});
  try{localStorage.setItem("calniu_lang",lang);}catch(e){}
}
document.addEventListener("DOMContentLoaded",function(){
  injectIcons();
  document.querySelectorAll(".lang button").forEach(function(b){b.addEventListener("click",function(){setLang(b.dataset.lang);});});
  var saved="ca"; try{saved=localStorage.getItem("calniu_lang")||"ca";}catch(e){}
  setLang(saved);
  var mb=document.getElementById("menuBtn"), nl=document.getElementById("navLinks");
  if(mb) mb.addEventListener("click",function(){nl.classList.toggle("open");});
  var here=(location.pathname.split("/").pop()||"index.html").toLowerCase();
  document.querySelectorAll("#navLinks a").forEach(function(a){
    var href=(a.getAttribute("href")||"").toLowerCase();
    if(href===here || (here===""&&href==="index.html")) a.classList.add("active");
  });
  var lb=document.getElementById("lightbox");
  if(lb){
    var lbimg=lb.querySelector("img");
    document.querySelectorAll(".gallery a").forEach(function(a){
      a.addEventListener("click",function(e){e.preventDefault();lbimg.src=a.getAttribute("href");lb.classList.add("open");});
    });
    lb.addEventListener("click",function(){lb.classList.remove("open");});
  }
});
function sendForm(e,tipo){
  e.preventDefault();
  var f=e.target, lang=document.documentElement.lang;
  var data=Object.fromEntries(new FormData(f).entries());
  var asunto = tipo==='vol' ? 'Voluntariat Cal Niu - '+(data.nom||'') : 'Inscripcio activitat Cal Niu - '+(data.nom||'');
  var body=''; for(var k in data){ body+=k+': '+data[k]+'\n'; }
  window.location.href='mailto:som.calniu@gmail.com?subject='+encodeURIComponent(asunto)+'&body='+encodeURIComponent(body);
  var msg={ca:"Gracies! S'obrira el teu correu per enviar la sol.licitud.",es:'Gracias! Se abrira tu correo para enviar la solicitud.',en:'Thanks! Your email client will open to send the request.'}[lang]||'';
  setTimeout(function(){alert(msg);},120);
  return false;
}
